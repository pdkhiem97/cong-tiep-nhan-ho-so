# Sao chép file này thành .env.local rồi điền giá trị thật.
# Chatbot trên trang chủ cần GEMINI_API_KEY; các biến còn lại dùng từ Tuần 3 trở đi.

# Gemini (Tuần 2: chatbot trên trang chủ). Chỉ dùng phía server, không thêm tiền tố NEXT_PUBLIC_.
GEMINI_API_KEY=

# Supabase phía server: lưu hội thoại chatbot. Secret key có toàn quyền trên database,
# tuyệt đối không thêm tiền tố NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Mật khẩu vào mục Hội thoại trong trang quản trị (tài khoản: admin). Để trống thì mục này bị khoá.
# Dùng mật khẩu dài, không dùng lại mật khẩu khác, không thêm tiền tố NEXT_PUBLIC_.
ADMIN_PASSWORD=

# Supabase (Tuần 3: database + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
